# حماية الملفات الحساسة
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# منع الوصول المباشر للملفات الحساسة
<FilesMatch "(^\.env|^composer\.(json|lock)|^package(-lock)?\.json|artisan)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# إعادة توجيه جميع الطلبات إلى public folder
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

